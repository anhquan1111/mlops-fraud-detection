# .dockerignore — exclude heavy/sensitive files from Docker build context

# Python cache
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/

# Virtual environment (Docker installs its own via uv)
.venv/
venv/

# ML artifacts — never baked into the image. The model is fetched at runtime
# from Hugging Face Hub (HF_REPO_ID) or bind-mounted via MODEL_PATH.
mlruns/
mlartifacts/
mlflow.db
models/
*.pkl.bak

# Data — never copy training data into image
data/

# Notebooks — not needed at runtime
notebooks/

# Tests — not needed at runtime
tests/

# Dev tools
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.log

# Git / IDE
.git/
.gitignore
.vscode/
.idea/

# Docs
docs/
*.md

# Scripts (only needed for dev, not runtime)
scripts/
