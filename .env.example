# ==========================================
# Cấu hình môi trường (Local Development)
# ==========================================

# MLflow Tracking (mặc định dùng SQLite local)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fraud-detection

# Thư mục lưu báo cáo chất lượng & drift
FRAUD_REPORTS_DIR=reports

# Ngưỡng phân loại gian lận (từ 0.0 đến 1.0)
DECISION_THRESHOLD=0.5

# Docker Compose local: tên file phải tồn tại bên trong thư mục models/
MODEL_FILENAME=fraud_model.pkl

# Grafana local chỉ bind vào 127.0.0.1; đổi password nếu máy được dùng chung
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=fraud-local-only

# Cấu hình AWS S3 (để trống để chạy lưu trữ local)
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
